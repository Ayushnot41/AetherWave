/**
 * DEMO_MODE environment setup for local development.
 * Copy this to .env.local for instant no-key-required development.
 * 
 * Usage: Copy-Item .env.demo .env.local
 */

# Enables all demo fixtures — no real API keys required
DEMO_MODE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_AI_GATEWAY_URL=http://localhost:3001/v1
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# These are ignored when DEMO_MODE=true but must exist for Next.js env parsing
AI_GATEWAY_API_KEY=demo-no-key-needed
GEMINI_API_KEY=demo-no-key-needed
SOLANA_FEE_PAYER_SECRET=demo-no-key-needed
ELEVENLABS_API_KEY=demo-no-key-needed
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TWILIO_ACCOUNT_SID=demo-no-key-needed
TWILIO_AUTH_TOKEN=demo-no-key-needed
TWILIO_VERIFY_SERVICE_SID=demo-no-key-needed
TWILIO_FROM_NUMBER=+1234567890
JWT_SECRET=demo-local-jwt-secret-not-for-production
DB_CONNECTION_STRING=
