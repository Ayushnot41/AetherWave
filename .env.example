# ==============================================================================
# AetherWave Environment Configuration
# Institutional Indian Government & National Agro-Resilience Grid
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI CAPABILITIES (PRIMARY / ESSENTIAL)
# ------------------------------------------------------------------------------
# Google Gemini API key:
# - Powers Bhu-Drishti crop canopy multimodal damage audit (gemini-2.5-flash)
# - Powers Kisan Sahayak 24/7 AI Agronomic Copilot (gemini-2.5-flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SOLANA BLOCKCHAIN & MICRO-RELIEF ESCROW (OPTIONAL - FOR REAL DEVNET PAYOUTS)
# ------------------------------------------------------------------------------
# Solana Devnet RPC endpoint (default public Devnet RPC is used if left blank)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Devnet Treasury Private Key (Base58 encoded or JSON array)
# Used to disburse real micro-relief SOL/tokens to verified farmer wallets
SOLANA_TREASURY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. DIRECT SMS DISPATCH FOR KEYPAD PHONES (OPTIONAL - HEADLESS SERVER BROADCAST)
# ------------------------------------------------------------------------------
# Note: AetherWave already includes client-side SMS tel: and WhatsApp deep links
# that work 100% free with zero backend. If you want automated server-side SMS push:
#
# Option A: Fast2SMS (India Quick SMS Gateway)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
#
# Option B: MSG91 (Govt / Enterprise DLT SMS)
# MSG91_AUTH_KEY=your_msg91_auth_key_here
#
# Option C: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. SATELLITE MULTISPECTRAL IMAGERY (OPTIONAL - REAL SENTINEL-2 NDVI)
# ------------------------------------------------------------------------------
# Default: High-fidelity coordinate-deterministic multispectral reflectance simulation.
# For live Sentinel-2 / Landsat surface reflectance:
# OpenWeather Agromonitoring API key (https://agromonitoring.com/api):
AGROMONITORING_API_KEY=

# ------------------------------------------------------------------------------
# 5. OPEN GOVERNMENT DATA (DATA.GOV.IN) AGMARKNET MANDI FEED (OPTIONAL)
# ------------------------------------------------------------------------------
# Default: Embedded high-accuracy 2026 APMC mandi benchmark prices.
# For live automated pull from Ministry of Agriculture & Farmers Welfare API:
DATA_GOV_IN_API_KEY=

# ------------------------------------------------------------------------------
# 6. APP ENVIRONMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. ELEVENLABS VERNACULAR VOICE SYNTHESIS (SWEET FEMALE HINDI VOICE)
# ------------------------------------------------------------------------------
# Powers sweet natural female voice guidance in Hindi, Marathi, Bengali, and English.
# Voice ID EXAVITQu4vr4xnSDxMaL (Sarah) provides sweet, gentle, calm Hindi delivery.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

